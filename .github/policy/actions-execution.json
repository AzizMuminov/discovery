{
  "name": "Reviewed pull request automation",
  "enforcement": "active",
  "conditions": {
    "workflow_path": {
      "include": [
        ".github/workflows/auto-merge-on-approval.yml",
        ".github/workflows/check-agent-removal-impact.yml",
        ".github/workflows/pr-review.yml"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "restrict_action_events",
      "parameters": {
        "allowed_events": [
          "pull_request_target",
          "pull_request_review"
        ]
      }
    }
  ]
}
